# frontend/.env.local
# Copy this to .env.local and fill in values after deploying both contracts.
# Never commit .env.local

# ── GenLayer ──────────────────────────────────────────────────────────────────
# Deploy community_pulse.py to GenLayer studionet and paste the address here.
# If reusing a V1 deploy note: V2 adds member_stake param to create_community
# and arc_tx_hash param to join_community — you MUST redeploy.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x_YOUR_GENLAYER_CONTRACT_ADDRESS

# ── ARC ───────────────────────────────────────────────────────────────────────
# Deploy CommunityEscrow.sol to ARC testnet (see contracts-arc/README).
# The contract address printed by Foundry after `forge script ... --broadcast`.
NEXT_PUBLIC_ARC_ESCROW_ADDRESS=0x_YOUR_ARC_ESCROW_CONTRACT_ADDRESS

# ARC testnet RPC — do not change
NEXT_PUBLIC_ARC_RPC=https://rpc.testnet.arc.network

# ARC testnet chain ID — do not change
NEXT_PUBLIC_ARC_CHAIN_ID=5042002

# ARC testnet USDC address — do not change
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Relay wallet private key.
# This wallet:
#   - pays gas (USDC) for releaseStake and slashStake calls
#   - is the potAddress registered per community (slash destination on testnet)
#   - was the deployer of CommunityEscrow (same key used in Foundry deploy)
# WARNING: This key is exposed to the browser on testnet. Acceptable for demo.
# Keep funded with ≥5 USDC. Faucet: faucet.circle.com → Arc Testnet → USDC.
# If balance drops below 1 USDC, the founder dashboard shows a warning.
NEXT_PUBLIC_RELAY_PRIVATE_KEY=
57b7203a30d4cc2384070726bf660c957772b94aea401209746411b208ae7e9a